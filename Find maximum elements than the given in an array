import java.util.Scanner;

public class MaxThanGiven {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int arr[]=new int[5];
		for(int i=0;i<5;i++) {
			arr[i]=sc.nextInt();
		}
		int X = sc.nextInt();
		for(int j:arr) {
			if(j>X)System.out.print(j + " ");
		}

	}

}
