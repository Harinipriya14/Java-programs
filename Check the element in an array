import java.util.Scanner;

public class isPresent {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int a[]=new int[3];
		for(int i=0;i<3;i++) {
			a[i]=sc.nextInt();
		}
		int target=sc.nextInt();
		boolean flag=false;
		for(int i:a) {
			if(target==i) {
				flag = true;
			}
		}
		System.out.println(flag==true?"Yes":"No");
	}

}
