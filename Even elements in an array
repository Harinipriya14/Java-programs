import java.util.Scanner;

public class EvenFromArray {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
		int arr[] = new int[n];
		for(int i=0;i<n;i++) {
			arr[i] = sc.nextInt();
		}
		for(int j:arr) {
			if((j&1) == 0) {
				System.out.print(j+" ");
			}
		}

	}

}
